# Copy to .env and replace every CHANGE_ME value before deployment.
AWS_REGION=us-east-1
IKI_S3_BUCKET=mantra-industrial-docs-657157860151
IKI_API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_GRAFANA_PASSWORD
MANTRA_WEB_USER=mantra
# Generate with `caddy hash-password`; single quotes preserve bcrypt dollar signs.
MANTRA_WEB_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'

# Use :80 for local HTTP. Set a real DNS name to enable Caddy automatic HTTPS.
MANTRA_SITE_ADDRESS=:80
MANTRA_ACME_EMAIL=operator@example.com
MANTRA_TLS_SERVER_NAME=localhost
MANTRA_GRAFANA_ROOT_URL=http://localhost:3000/grafana/

# Jenkins supplies the immutable ECR image tag during deployment.
MANTRA_BACKEND_IMAGE=mantra-backend:local
IKI_AUTO_CREATE_SCHEMA=false
IKI_RATE_LIMIT_PER_MINUTE=120
